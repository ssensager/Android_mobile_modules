<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEquipmentName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_equipment_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/hint_muscle_group"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAddMuscle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAddChest"
            style="@style/Widget.Lab6.MuscleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/group_chest" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAddBack"
            style="@style/Widget.Lab6.MuscleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_back" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAddLegs"
            style="@style/Widget.Lab6.MuscleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_legs" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAddShoulders"
            style="@style/Widget.Lab6.MuscleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_shoulders" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAddArms"
            style="@style/Widget.Lab6.MuscleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_arms" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_equipment_notes">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEquipmentNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
